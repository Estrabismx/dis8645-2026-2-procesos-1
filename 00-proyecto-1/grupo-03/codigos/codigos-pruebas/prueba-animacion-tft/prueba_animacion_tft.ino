void setup() {
  tft.init(240, 320);
  tft.setRotation(1); // 320x240 px
  tft.fillScreen(ST77XX_BLACK);

  // Preparamos la capa oculta del texto que estará esperando detrás
  textCanvas.fillScreen(0);
  textCanvas.drawRoundRect(25, 82, 270, 60, 10, 1);
  textCanvas.drawRoundRect(27, 84, 266, 56, 8, 1);
  textCanvas.setTextColor(1);
  textCanvas.setTextSize(3);
  textCanvas.setCursor(45, 100);
  textCanvas.print("hola kriss :V");
}

// Desintegra la imagen por estática uniforme revelando el texto oculto
void desintegrarRevelandoTexto() {
  for (int step = 0; step < 110; step++) {
    for (int i = 0; i < 1100; i++) {
      int x = random(0, 320);
      int y = random(0, 240);

      // Si el punto pertenece al texto/marco oculto, pinta amarillo; si no, fondo negro
      if (textCanvas.getPixel(x, y)) {
        tft.drawPixel(x, y, ST77XX_YELLOW);
      } else {
        tft.drawPixel(x, y, ST77XX_BLACK);
      }
    }
    delay(8); // Velocidad de la disolución
  }
}

// Redibuja el mensaje final con colores limpios
void fijarMensajeFinal() {
  tft.drawRoundRect(25, 82, 270, 60, 10, ST77XX_CYAN);
  tft.drawRoundRect(27, 84, 266, 56, 8, ST77XX_BLUE);
  tft.setTextColor(ST77XX_YELLOW);
  tft.setTextSize(3);
  tft.setCursor(45, 100);
  tft.println("hola kriss :V");
}

void loop() {
  // 1. Dibuja la imagen completa en el frente
  tft.fillScreen(ST77XX_BLACK);
  tft.drawBitmap(0, 0, epd_bitmap_650_1200, 320, 240, ST77XX_WHITE, ST77XX_BLACK);
  delay(2500);

  // 2. Disuelve la imagen en ruido aleatorio revelando el texto de fondo
  desintegrarRevelandoTexto();

  // 3. Afina los bordes del mensaje final
  fijarMensajeFinal();
  delay(4000);
}
