const char autora[] = "Mary Oliver";
const char titulo[] = "Gansos salvajes";
const char instruccionPot[] = "Gira potenciometro";


const char* licencia[] = {
  "Proyecto academico",
  "Fragmento de 'Wild Geese'",
  "por Mary Oliver",
  "Uso educativo no comercial",
