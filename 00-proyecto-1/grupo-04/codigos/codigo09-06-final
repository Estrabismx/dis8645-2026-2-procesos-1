int leerTamanoLetra() {

  int lecturaPot =
    analogRead(POTENCIOMETRO);

  return constrain(
    map(
      lecturaPot,
      0,
      1023,
      1,
      3
    ),
    1,
    3
  );
}


// ======================================================
// ESCRIBIR LETRA POR LETRA
// ======================================================

// Mantiene la escritura letra por letra.
//
// La diferencia es que antes de dibujar cada letra
// comprobamos si la palabra completa cabe en la línea.
// Si no cabe, la palabra comienza completa en la siguiente línea.
//
// Así:
// - las letras siguen apareciendo una por una
// - ninguna palabra se corta entre dos líneas
// - el potenciometro sigue controlando el tamaño

bool escribirLetraPorLetra(
  const char *texto,
  int velocidad
) {

  int longitud =
    strlen(texto);


  for (
    int i = 0;
    i < longitud;
    i++
  ) {

    leerControles();


    if (
      cancelarReproduccion
    ) {

      return false;
    }


    int tamano =
      leerTamanoLetra();


    display.clearDisplay();

    display.setTextColor(
      SSD1306_WHITE
    );

    display.setTextSize(
      tamano
    );

    display.setTextWrap(false);


    // --------------------------------------------------
    // CALCULAR LA POSICION DE CADA PALABRA
    // --------------------------------------------------

    int x = 0;
    int y = 0;

    int anchoCaracter =
      6 * tamano;

    int altoLinea =
      8 * tamano;


    // recorrer todas las palabras hasta la letra actual

    int posicion = 0;


    while (
      posicion <= i &&
      texto[posicion] != '\0'
    ) {

      // saltar espacios
      if (
        texto[posicion] == ' '
      ) {

        posicion++;
        continue;
      }


      // encontrar dónde termina la palabra

      int inicioPalabra =
        posicion;

      int finalPalabra =
        posicion;


      while (
        texto[finalPalabra] != ' ' &&
        texto[finalPalabra] != '\0'
      ) {

        finalPalabra++;
      }


      int largoPalabra =
        finalPalabra - inicioPalabra;


      int anchoPalabra =
        largoPalabra * anchoCaracter;


      // ------------------------------------------------
      // COMPROBAR SI LA PALABRA CABE
      // ------------------------------------------------

      if (
        x > 0 &&
        x + anchoPalabra > ANCHO_PANTALLA
      ) {

        x = 0;

        y += altoLinea;
      }


      // ------------------------------------------------
      // DIBUJAR SOLO LAS LETRAS QUE YA CORRESPONDEN
      // ------------------------------------------------

      int limite =
        finalPalabra;


      // Si esta es la palabra que contiene
      // la letra que estamos escribiendo,
      // solamente mostramos hasta i.

      if (
        i >= inicioPalabra &&
        i < finalPalabra
      ) {

        limite =
          i + 1;
      }


      for (
        int j = inicioPalabra;
        j < limite;
        j++
      ) {

        display.setCursor(
          x,
          y
        );

        display.print(
          texto[j]
        );

        x += anchoCaracter;
      }


      // Si ya llegamos a la palabra actual,
      // no seguimos dibujando palabras futuras.

      if (
        i >= inicioPalabra &&
        i < finalPalabra
      ) {

        break;
      }


      // si la palabra ya estaba completamente escrita,
      // avanzar hacia la siguiente

      x += anchoCaracter;

      posicion =
        finalPalabra + 1;
    }


    display.display();


    if (
      !pausaControlada(
        velocidad
      )
    ) {

      return false;
    }
  }


  display.setTextWrap(true);

  return true;
}


// ------------------------------------------------
// PAUSA CONTROLADA
// ------------------------------------------------

bool pausaControlada(
  unsigned long tiempo
) {

  unsigned long inicio =
    millis();

  while (
    millis() - inicio < tiempo
  ) {

    leerControles();

    if (
      cancelarReproduccion == true
    ) {

      return false;
    }

    delay(5);
  }

  return true;
}


// ------------------------------------------------
// EFECTO MOLINO
// ------------------------------------------------

bool moverMolino(
  const char *texto
) {

  for (
    int x = 128;
    x >= -128;
    x--
  ) {

    leerControles();

    if (
      cancelarReproduccion == true
    ) {

      return false;
    }

    display.clearDisplay();
    display.setTextColor(SSD1306_WHITE);
    display.setTextSize(leerTamanoLetra());
    display.setCursor(x, 10);
    display.print(texto);
    display.display();

    if (
      !pausaControlada(30)
    ) {

      return false;
    }
  }

  for (
    int x = -128;
    x <= 128;
    x++
  ) {

    leerControles();

    if (
      cancelarReproduccion == true
    ) {

      return false;
    }

    display.clearDisplay();
    display.setTextColor(SSD1306_WHITE);
    display.setTextSize(leerTamanoLetra());
    display.setCursor(x, 10);
    display.print(texto);
    display.display();

    if (
      !pausaControlada(30)
    ) {

      return false;
    }
  }

  return true;
}


