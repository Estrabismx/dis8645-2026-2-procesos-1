// ======================================================
// ACUMULACION DE TEXTO
// ======================================================

bool mostrarAcumulacion(
  const char *texto1,
  const char *texto2,
  const char *texto3,
  const char *texto4
) {

  const char *textos[] = {
    texto1,
    texto2,
    texto3,
    texto4
  };


  // mostrar cada repetición de "bawl"
  // mantener las anteriores visibles
  // aumentar progresivamente la intensidad

  for (
    int cantidad = 1;
    cantidad <= 4;
    cantidad++
  ) {

    leerControles();

    if (cancelarReproduccion) {
      return false;
    }


    display.clearDisplay();

    display.setTextColor(
      SSD1306_WHITE
    );

    display.setTextSize(1);


    // acumular los textos anteriores
    for (
      int i = 0;
      i < cantidad;
      i++
    ) {

      display.setCursor(
        0,
        i * 8
      );

      display.print(
        textos[i]
      );
    }


    display.display();


    // cada repetición aparece más rápido
    // y aumenta la sensación de acumulación

    if (
      !pausaControlada(
        500 - (cantidad * 70)
      )
    ) {

      return false;
    }
  }


  return true;
}


