    cambiarBrillo(brillo);


    display.clearDisplay();

    display.setTextColor(
      SSD1306_WHITE
    );

    display.setTextSize(
      tamano
    );


    display.setCursor(
      0,
      8
    );

    display.print(
      texto
    );

    display.display();


    if (
      !pausaControlada(250)
    ) {

      return false;
    }
  }


  cambiarBrillo(100);


  return pausaControlada(800);
}


