// ======================================================
// TRIGGER WARNING
// ======================================================

bool mostrarWarning(
  const char *texto
) {

  // mostrar el trigger warning durante más tiempo
  // alternar entre fondo negro y fondo blanco
  // generar un parpadeo visual de advertencia

  for (
    int i = 0;
    i < 6;
    i++
  ) {

    if (i % 2 == 0) {

      // fondo negro con letras blancas

      cambiarBrillo(100);

      display.clearDisplay();

      display.fillScreen(
        SSD1306_BLACK
      );

      display.setTextColor(
        SSD1306_WHITE
      );

    }

    else {

      // fondo blanco con letras negras

      display.clearDisplay();

      display.fillScreen(
        SSD1306_WHITE
      );

      display.setTextColor(
        SSD1306_BLACK
      );
    }


    display.setTextSize(1);

    display.setCursor(
      0,
      0
    );

    display.println(
      "TRIGGER WARNING"
    );

    display.println("");

    display.println(
      "violence and abuse"
    );

    display.display();


    if (
      !pausaControlada(600)
    ) {

      return false;
    }
  }


  // volver a la configuración normal

  cambiarBrillo(100);

  display.clearDisplay();

  display.setTextColor(
    SSD1306_WHITE
  );

  display.display();


  return pausaControlada(1200);
}


