// ======================================================
// EFECTO PULSO
// ======================================================

bool mostrarPulso(
  const char *texto
) {

  leerControles();


  if (cancelarReproduccion) {

    return false;
  }


  // tamaño base definido por el potenciometro
  int tamanoBase =
    leerTamanoLetra();


  // --------------------------------------
  // AGRANDAR
  // --------------------------------------

  for (
    int tamano = tamanoBase;
    tamano <= tamanoBase + 1;
    tamano++
  ) {

    display.clearDisplay();

    display.setTextColor(
      SSD1306_WHITE
    );

    display.setTextSize(
      tamano
    );

    display.setCursor(
      0,
      0
    );

    display.print(
      texto
    );

    display.display();


    if (
      !pausaControlada(300)
    ) {

      return false;
    }
  }


  // --------------------------------------
  // ACHICAR
  // --------------------------------------

  display.clearDisplay();

  display.setTextColor(
    SSD1306_WHITE
  );

  display.setTextSize(
    tamanoBase
  );

  display.setCursor(
    0,
    0
  );

  display.print(
    texto
  );

  display.display();


  if (
    !pausaControlada(350)
  ) {

    return false;
  }


  return true;
}


// ======================================================
// CONTROL DE BRILLO
// ======================================================

void cambiarBrillo(int porcentaje) {

  int valorBrillo =
    map(porcentaje, 0, 100, 0, 255);

  display.ssd1306_command(
    SSD1306_SETCONTRAST
  );

  display.ssd1306_command(
    valorBrillo
  );
}


