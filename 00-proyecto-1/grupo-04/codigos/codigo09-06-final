// ------------------------------------------------
// SETUP
// ------------------------------------------------

void setup() {

  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    while (true);
  }

  pinMode(BOTON_PLAY, INPUT_PULLUP);
  pinMode(BOTON_STOP, INPUT_PULLUP);
  pinMode(BOTON_REPEAT, INPUT_PULLUP);

  display.setTextColor(SSD1306_WHITE);

  for (int i = 0; i < cantidadLineasIntro; i++) {

    display.clearDisplay();
    display.setTextColor(SSD1306_WHITE);
    display.setTextSize(1);
    display.setCursor(0, 0);
    display.println(intro[i]);
    display.display();

    delay(900);
  }

  // despues de la portada, comienza el poema
  reproduciendo = true;
  cancelarReproduccion = false;
}


// ------------------------------------------------
// LOOP
// ------------------------------------------------

void loop() {

  leerControles();

  if (reproduciendo == true) {

    reproducirPoema();

    if (
      cancelarReproduccion == false &&
      repetir == true
    ) {

      reproduciendo = true;

    } else {

      reproduciendo = false;
    }
  }
}


// ------------------------------------------------
