// ------------------------------------------------
// CONTROLADORES
// ------------------------------------------------

void leerControles() {

  bool play =
    digitalRead(BOTON_PLAY);

  bool stop =
    digitalRead(BOTON_STOP);

  bool repeatBtn =
    digitalRead(BOTON_REPEAT);


  // PLAY
  if (
    ultimoPlay == HIGH &&
    play == LOW
  ) {

    reproduciendo = true;
    cancelarReproduccion = false;
  }

  ultimoPlay = play;


  // STOP
  if (
    ultimoStop == HIGH &&
    stop == LOW
  ) {

    reproduciendo = false;
    cancelarReproduccion = true;

    display.clearDisplay();
    display.display();
  }

  ultimoStop = stop;


  // REPEAT
  if (
    ultimoRepeat == HIGH &&
    repeatBtn == LOW
  ) {

    repetir = !repetir;
  }

  ultimoRepeat = repeatBtn;
}


