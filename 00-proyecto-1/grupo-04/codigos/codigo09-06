// ======================================================
// SETUP
// ======================================================

void setup() {

  Serial.begin(9600);

  delay(1000);


  // --------------------------------------
  // BOTONES
  // --------------------------------------

  pinMode(BOTON_PLAY, INPUT_PULLUP);
  pinMode(BOTON_STOP, INPUT_PULLUP);
  pinMode(BOTON_REPEAT, INPUT_PULLUP);


  // --------------------------------------
  // POTENCIOMETRO
  // --------------------------------------

  // Dejamos A0 trabajando de 0 a 1023
  analogReadResolution(10);


  // --------------------------------------
  // OLED
  // --------------------------------------

  Wire.begin();

  if (!display.begin(
        SSD1306_SWITCHCAPVCC,
        0x3C
      )) {

    Serial.println("ERROR OLED");

    while (true);
  }


  display.clearDisplay();

  display.setTextColor(SSD1306_WHITE);

  display.setTextWrap(true);

  display.display();


  // --------------------------------------
  // PANTALLA INICIAL
  // --------------------------------------

  mostrarInicio();

  Serial.println("SISTEMA LISTO");
}


// ======================================================
// LOOP
// ======================================================

void loop() {

  leerControles();


  // Si presionamos PLAY
  if (reproduciendo == true) {

    cancelarReproduccion = false;

    bool terminoCorrectamente =
      reproducirPoema();


    // --------------------------------------
    // STOP
    // --------------------------------------

    if (
      cancelarReproduccion == true ||
      terminoCorrectamente == false
    ) {

      reproduciendo = false;

      // STOP ya limpio la pantalla

      return;
    }


    // --------------------------------------
    // REPEAT
    // --------------------------------------

    if (repetir == true) {

      Serial.println("REPETIR POEMA");

      reproduciendo = true;

      delay(200);

    }

    else {

      reproduciendo = false;

      mostrarFin();
    }
  }
}


// ======================================================
// LEER BOTONES
// ======================================================

void leerControles() {

  bool playActual =
    digitalRead(BOTON_PLAY);

  bool stopActual =
    digitalRead(BOTON_STOP);

  bool repeatActual =
    digitalRead(BOTON_REPEAT);


  unsigned long ahora =
    millis();


  // ==================================================
  // PLAY
  // ==================================================

  if (
    ultimoPlay == HIGH &&
    playActual == LOW &&
    ahora - ultimoTiempoPlay > DEBOUNCE
  ) {

    ultimoTiempoPlay = ahora;


    // PLAY solamente inicia si estaba detenido
    if (!reproduciendo) {

      Serial.println("PLAY");

      cancelarReproduccion = false;

      reproduciendo = true;
    }
  }


  // ==================================================
  // STOP
  // ==================================================

  if (
    ultimoStop == HIGH &&
    stopActual == LOW &&
    ahora - ultimoTiempoStop > DEBOUNCE
  ) {

    ultimoTiempoStop = ahora;

    Serial.println("STOP");

    cancelarReproduccion = true;

    reproduciendo = false;


    // apagar OLED inmediatamente
    display.clearDisplay();

    display.display();
  }


  // ==================================================
  // REPEAT
  // ==================================================

  if (
    ultimoRepeat == HIGH &&
    repeatActual == LOW &&
    ahora - ultimoTiempoRepeat > DEBOUNCE
  ) {

    ultimoTiempoRepeat = ahora;

    repetir = !repetir;


    if (repetir) {

      Serial.println("REPEAT ON");

    }

    else {

      Serial.println("REPEAT OFF");
    }


    // Si el poema esta detenido,
    // mostrar el estado en la OLED

    if (!reproduciendo) {

      display.clearDisplay();

      display.setTextSize(1);

      display.setCursor(0, 0);


      if (repetir) {

        display.println("REPEAT ON");

      }

      else {

        display.println("REPEAT OFF");
      }


      display.display();
    }
  }


  // guardar estados
  ultimoPlay = playActual;

  ultimoStop = stopActual;

  ultimoRepeat = repeatActual;
}


// ======================================================
// POTENCIOMETRO
// ======================================================

int leerTamanoLetra() {

  int valor =
    analogRead(POTENCIOMETRO);


  // --------------------------------------
  // TRES NIVELES
  // --------------------------------------

  if (valor < 341) {

    return 1;
  }

  else if (valor < 682) {

    return 2;
  }

  else {

    return 3;
  }
}


// ======================================================
// PAUSA QUE SIGUE LEYENDO STOP / REPEAT
// ======================================================

bool pausaControlada(
  unsigned long tiempo
) {

  unsigned long inicio =
    millis();


  while (
    millis() - inicio < tiempo
  ) {

    leerControles();


    if (cancelarReproduccion) {

      return false;
    }


    delay(5);
  }


  return true;
}


// ======================================================
// ESCRIBIR LETRA POR LETRA
// ======================================================

bool escribirLetraPorLetra(
  const char *texto,
  int velocidad
) {

  int longitud =
    strlen(texto);


  for (
    int i = 0;
    i < longitud;
    i++
  ) {

    leerControles();


    if (cancelarReproduccion) {

      return false;
    }


    // tamaño actualizado EN VIVO
    int tamano =
      leerTamanoLetra();


    display.clearDisplay();

    display.setTextColor(
      SSD1306_WHITE
    );

    display.setTextSize(
      tamano
    );

    display.setCursor(
      0,
      0
    );


    // dibujar todo lo escrito hasta ahora
    for (
      int j = 0;
      j <= i;
      j++
    ) {

      display.print(
        texto[j]
      );
    }


    display.display();


    if (
      !pausaControlada(
        velocidad
      )
    ) {

      return false;
    }
  }


  return true;
}


// ======================================================
// EFECTO MOLINO
// ======================================================

bool moverMolino(
  const char *texto
) {

  // --------------------------------------
  // DERECHA -> IZQUIERDA
  // --------------------------------------

  for (
    int x = 128;
    x >= -128;
    x--
  ) {

    leerControles();


    if (cancelarReproduccion) {

      return false;
    }


    display.clearDisplay();

    display.setTextColor(
      SSD1306_WHITE
    );

    display.setTextSize(
      leerTamanoLetra()
    );

    display.setCursor(
      x,
      10
    );

    display.print(
      texto
    );

    display.display();


    if (
      !pausaControlada(20)
    ) {

      return false;
    }
  }


  // --------------------------------------
  // IZQUIERDA -> DERECHA
  // --------------------------------------

  for (
    int x = -128;
    x <= 128;
    x++
  ) {

    leerControles();


    if (cancelarReproduccion) {

      return false;
    }


    display.clearDisplay();

    display.setTextColor(
      SSD1306_WHITE
    );

    display.setTextSize(
      leerTamanoLetra()
    );

    display.setCursor(
      x,
      10
    );

    display.print(
      texto
    );

    display.display();


    if (
      !pausaControlada(20)
    ) {

      return false;
    }
  }


  return true;
}


// ======================================================
// PALABRAS BURN / CUT / RAW / ACID
// ======================================================

bool mostrarGolpe(
  const char *texto
) {

  leerControles();


  if (cancelarReproduccion) {

    return false;
  }


  display.clearDisplay();


  // fondo blanco
  display.fillScreen(
    SSD1306_WHITE
  );


  // letras negras
  display.setTextColor(
    SSD1306_BLACK
  );


  // El pote tambien controla
  // el tamaño de estas palabras
  display.setTextSize(
    leerTamanoLetra()
  );


  display.setCursor(
    10,
    8
  );

  display.print(
    texto
  );

  display.display();


  if (
    !pausaControlada(500)
  ) {

    return false;
  }


  display.clearDisplay();

  display.setTextColor(
    SSD1306_WHITE
  );

  display.display();


  return pausaControlada(150);
}


