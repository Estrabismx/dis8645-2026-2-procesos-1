// ==========================================
// CONFIGURACIÓN INICIAL
// ==========================================


void setup() {


  // Iniciar comunicación I2C
  Wire.begin();


  // Iniciar pantalla OLED
  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR)) {


    // Si la pantalla no es encontrada,
    // el Arduino se queda detenido aquí
    while (true) {
      delay(100);
    }
  }


  // Limpiar pantalla
  display.clearDisplay();


  // Dibujar el caballo
  display.drawBitmap(
    0,                  // X
    0,                  // Y
    caballo,            // Bitmap
    caballo_width,      // Ancho
    caballo_height,     // Alto
    SSD1306_WHITE       // Color
  );


  // Mostrar imagen
  display.display();
}




// ==========================================
// LOOP
// ==========================================


void loop() {
  // La imagen permanece fija
}




